# GitHub OAuth App — crie em https://github.com/settings/developers
# Callback URL configurada no app: http://localhost:8080/auth-callback
VITE_REDIRECT_URI=http://localhost:8080/auth-callback
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# URL do backend Spring Boot
VITE_BACKEND_URL=http://localhost:8081
